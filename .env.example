# 複製成 .env 後填入。不要把 .env 提交到 Git。

# LINE Developers Console > Messaging API channel
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Bot 伺服器
PORT=3000

# pnpm tunnel 用：找不到 cloudflared 時填完整路徑（選填）
# 例：CLOUDFLARED_BIN=C:\Program Files (x86)\cloudflared\cloudflared.exe
# CLOUDFLARED_BIN=

# 本機開發用（docker/docker-compose.dev.yml）
DATABASE_URL=postgres://travel:travel@localhost:5432/travel
REDIS_URL=redis://localhost:6379
